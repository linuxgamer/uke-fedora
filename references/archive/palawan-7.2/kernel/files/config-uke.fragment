# uke.fragment — config поверх arm64 defconfig для базы palawan 7.2.
# Черновик фазы 0. Для ручного bring-up (ztsubaki-стиль). Проверить на сборке.
# В pmOS kernel-пакете конфиг формируется иначе (см. pmos/).

# --- Платформа SoC (palawan) ---
CONFIG_PINCTRL_PALAWAN=y
CONFIG_CLK_PALAWAN_GCC=y
CONFIG_INTERCONNECT_QCOM_PALAWAN=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGMAP=y

# --- UFS ---
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y

# --- USB2 peripheral / gadget (ранний канал отладки) ---
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_U_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_G_SERIAL=y
CONFIG_USB_GADGET_VBUS_DRAW=2

# --- LED / torch ---
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_QCOM_FLASH=y

# --- simplefb-консоль (ABL framebuffer) ---
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# --- Логи ---
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# --- Панель O82 (dual-DSI DSC), черновик драйвера ---
CONFIG_DRM_PANEL_XIAOMI_O82=m

# --- Тачскрин Novatek NT36532, черновик драйвера ---
CONFIG_TOUCHSCREEN_NT36532_UKE=m

# --- Стабильный KVER (7.2.0-rc2-uke) ---
# CONFIG_LOCALVERSION_AUTO is not set

# --- EFI zboot (Fedora-нативный vmlinuz.efi) ---
CONFIG_EFI_ZBOOT=y

# --- USB gadget в initramfs (консоль/сеть для отладки) ---
CONFIG_USB_CONFIGFS=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_ACM=y
