#!/usr/bin/python3
"""Keep the Nanosic WN8030 keyboard auth window alive without TrustZone.

3-minute window, seek 1.5s idle gap. If found, rebind ONCE per window.
After rebind, restart new 3-minute window.
"""

import glob
import os
import select
import struct
import subprocess
import time

DRIVER = "/sys/bus/i2c/drivers/nanosic_wn8030"
DEVICE = "5-004c"
IDLE_GAP = 1.5
WINDOW = 180
UNBIND_DELAY = 0.01

def find_event():
    for name in glob.glob("/sys/class/input/event*/device/name"):
        try:
            if open(name).read().strip() == "Xiaomi Keyboard":
                return "/dev/input/" + name.split("/")[-3]
        except OSError:
            pass
    return None


def rebind():
    subprocess.run(
        [
            "/bin/sh",
            "-c",
            f"echo {DEVICE} > {DRIVER}/unbind; sleep {UNBIND_DELAY}; "
            f"echo {DEVICE} > {DRIVER}/bind",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def main():
    window_start = time.monotonic()
    last_key = window_start
    rebind_done = False

    while True:
        path = find_event()
        if not path or not os.path.exists(f"{DRIVER}/{DEVICE}"):
            time.sleep(1)
            continue

        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            time.sleep(1)
            continue

        try:
            while True:
                now = time.monotonic()
                ready, _, _ = select.select([fd], [], [], 0.5)
                if ready:
                    data = os.read(fd, 24 * 64)
                    for offset in range(0, len(data) - 23, 24):
                        _, _, ev_type, _, _ = struct.unpack_from("qqHHI", data, offset)
                        if ev_type == 1:
                            last_key = now

                elapsed = now - window_start

                if elapsed >= WINDOW:
                    if not rebind_done:
                        rebind()
                        rebind_done = True
                    window_start = now
                    last_key = now
                    rebind_done = False
                    break

                if not rebind_done and (now - last_key) >= IDLE_GAP:
                    rebind()
                    rebind_done = True
                    window_start = now
                    last_key = now
                    break

        except OSError:
            pass
        finally:
            os.close(fd)

        time.sleep(1)


if __name__ == "__main__":
    main()
