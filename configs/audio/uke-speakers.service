[Unit]
Description=Unmute Xiaomi Pad 7 speakers
After=pipewire.service wireplumber.service
Before=systemd-suspend.service systemd-hibernate.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 3
ExecStart=/bin/sh -c "amixer -c 0 cset numid=55 1; amixer -c 0 cset numid=58 1; amixer -c 0 cset numid=61 1; amixer -c 0 cset numid=64 1; amixer -c 0 cset numid=13 1; amixer -c 0 cset numid=19 1"
RemainAfterExit=yes

[Install]
WantedBy=default.target suspend.target hibernate.target hybrid-sleep.target
