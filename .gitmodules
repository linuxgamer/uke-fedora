[submodule "kernel/senemos"]
	path = kernel/senemos
	url = https://github.com/MCC45TR/senemos-uke-kernel-mainline.git
	shallow = true
[submodule "rootfs/device-helpers/hardware-support"]
	path = rootfs/device-helpers/hardware-support
	url = https://github.com/MCC45TR/uke-linux-hardware-support.git
	shallow = true
[submodule "rootfs/device-helpers/hexagonrpc"]
	path = rootfs/device-helpers/hexagonrpc
	url = https://github.com/linux-msm/hexagonrpc.git
	shallow = true
[submodule "rootfs/tty/buffybox"]
	path = rootfs/tty/buffybox
	url = https://gitlab.nura.eco/postmarketOS/buffybox.git
	shallow = true
