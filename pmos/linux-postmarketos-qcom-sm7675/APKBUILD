# Reference: <https://postmarketos.org/kernelpkg>
# База: palawan-mainline (mainline-форк для SM8635/SM7675) + uke-специфика.
maintainer="uke-linux-port"
pkgname=linux-postmarketos-qcom-sm7675
pkgver=7.2.0_rc2
pkgrel=0
pkgdesc="Mainline kernel for Qualcomm SM7675 (Xiaomi Pad 7 / uke)"
arch="aarch64"
_carch="arm64"
url="https://codeberg.org/palawan-mainline/linux"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	"
makedepends="
	bc
	bison
	clang
	elfutils-dev
	findutils
	flex
	git
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	"

_palawan_branch="palawan/v7.2-rc2"

source="
	config-$pkgname.$arch
	0001-uke-support.patch
"

# Клонируем базу вручную (Codeberg-архивы недоступны), применяем патч.
builddir="$srcdir/linux-palawan"

prepare() {
	git clone --depth 1 --branch "$_palawan_branch" \
		https://codeberg.org/palawan-mainline/linux.git "$builddir"
	cd "$builddir"
	git apply "$srcdir"/0001-uke-support.patch
	cp "$srcdir"/config-$pkgname.$arch .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 HOSTLDFLAGS="-fuse-ld=lld" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$pkgname"
}

package() {
	mkdir -p "$pkgdir"/boot
	make dtbs_install modules_install zinstall \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$pkgname"/kernel.release
}

