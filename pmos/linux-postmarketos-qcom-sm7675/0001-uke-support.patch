+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5c, 0xef);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5d, 0xe3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x5e, 0xd9);
