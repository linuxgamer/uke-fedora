+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc4, 0x82);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x26);
