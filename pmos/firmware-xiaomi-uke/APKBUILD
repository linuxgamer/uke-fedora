# Reference: <https://postmarketos.org/devicepkg>
# Блобы проприетарные и НЕ входят в репозиторий.
# Собери firmware.tar.gz из стоковой прошивки (см. README.md) и положи рядом.
maintainer="uke-linux-port"
pkgname=firmware-xiaomi-uke
pkgver=1
pkgrel=0
pkgdesc="Firmware for Xiaomi Pad 7 (uke)"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
depends="linux-firmware-qcom linux-firmware-ath11k"
source="
	firmware.tar.gz
	firmware.files
	30-initramfs-firmware.files
"
options="
	!archcheck
	!check
	!strip
	!tracedeps
	pmb:cross-native
	textrels
"
builddir="$srcdir"

package() {
	local _i
	while IFS="" read -r _i || [ -n "$_i" ]; do
		[ -z "$_i" ] && continue
		install -Dm644 "$builddir"/"$_i" "$pkgdir"/"$_i"
	done < "$srcdir"/firmware.files

	install -Dm644 "$srcdir"/30-initramfs-firmware.files \
		-t "$pkgdir"/usr/share/mkinitfs/files
}

# firmware.tar.gz собирается вручную из стока (tools/), checksum -> SKIP.
sha512sums="
SKIP  firmware.tar.gz
SKIP  firmware.files
SKIP  30-initramfs-firmware.files
"
