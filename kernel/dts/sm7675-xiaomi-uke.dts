		};

		vreg_l4m_2p8: ldo4 {
			regulator-name = "vreg_l4m_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l6m_2p8: ldo6 {
			regulator-name = "vreg_l6m_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7m_2p8: ldo7 {
			regulator-name = "vreg_l7m_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-6 {
		compatible = "qcom,pm8010-rpmh-regulators";
		qcom,pmic-id = "n";

		vreg_l1n_1p1: ldo1 {
			regulator-name = "vreg_l1n_1p1";
			regulator-min-microvolt = <1104000>;
			regulator-max-microvolt = <1104000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2n_1p056: ldo2 {
			regulator-name = "vreg_l2n_1p056";
			regulator-min-microvolt = <1056000>;
			regulator-max-microvolt = <1056000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3n_1p8: ldo3 {
			regulator-name = "vreg_l3n_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l4n_1p8: ldo4 {
			regulator-name = "vreg_l4n_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l5n_1p8: ldo5 {
			regulator-name = "vreg_l5n_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l6n_2p8: ldo6 {
			regulator-name = "vreg_l6n_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7n_3p3: ldo7 {
			regulator-name = "vreg_l7n_3p3";
			regulator-min-microvolt = <3304000>;
			regulator-max-microvolt = <3304000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&gpi_dma0 {
	status = "okay";
};

&gpi_dma1 {
	status = "okay";
};

&gpu {
	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/palawan/gen71100_zap.mbn";
};

&ipa {
	qcom,gsi-loader = "self";
	memory-region = <&ipa_fw_mem>;
	firmware-name = "qcom/palawan/ipa_fws.mbn";
	status = "okay";
};

&iris {
	status = "okay";
};

&lpass_tlmm {
	spkr_1_sd_n_active: spkr-1-sd-n-active-state {
		pins = "gpio13";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};
};

&mdss {
	status = "okay";
};

/*
 * Панель uke — O82, DUAL DSI + DSC (LCD, video mode, TDDI).
 * Варианты (по panel-id): O82 42 02 0B / O82 36 02 0A.
 * Reset: gpio2. ESD IRQ: gpio168/169 (драйвером пока не обрабатывается).
 * Reset sequence: <0 10 1 3 0 3 1 15>.
 * Питание: vddio=L8B(1.9V), vsp=gpio74(5.8V), vsn=gpio75(5.8V).
 * Формат: 30 bpp, DSC 10->8bpp, slice 800x24; dual DSI; 120/144/90 Гц.
 * Драйвер: kernel/drivers/panel-xiaomi-o82.c (черновик).
 */
&mdss_dsi0 {
	vdda-supply = <&vreg_l4b_1p2>;

	status = "okay";

	panel@0 {
		compatible = "xiaomi,o82";
		reg = <0>;

		reset-gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;

		vddio-supply = <&vreg_l8b_1p8>;
		vsp-supply = <&display_panel_vsp>;
		vsn-supply = <&display_panel_vsn>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				panel0_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;

				panel1_in: endpoint {
					remote-endpoint = <&mdss_dsi1_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi1 {
	vdda-supply = <&vreg_l4b_1p2>;

	status = "okay";
};

&mdss_dsi1_out {
	remote-endpoint = <&panel1_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi1_phy {
	vdds-supply = <&vreg_l2b_0p95>;

	status = "okay";
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l2b_0p95>;

	status = "okay";
};

&mdss_dp0 {
	status = "okay";
};

/* Питание панели uke: vsp/vsn через фиксированные регуляторы на GPIO74/75. */
/ {
	display_panel_vsp: regulator-vsp {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_vsp";
		regulator-min-microvolt = <5800000>;
		regulator-max-microvolt = <5800000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 74 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	display_panel_vsn: regulator-vsn {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_vsn";
		regulator-min-microvolt = <5800000>;
		regulator-max-microvolt = <5800000>;
		regulator-enable-ramp-delay = <233>;
		gpio = <&tlmm 75 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};
};

/* uke: L8B питает панель (vddil8b) при 1.9 В (в lamma-qrd — 1.8 В). */
&vreg_l8b_1p8 {
	regulator-min-microvolt = <1900000>;
	regulator-max-microvolt = <1900000>;
};

/*
 * Подсветка uke — 2x KTZ8866 (левая/правая половины), адрес 0x11.
 * Downstream: qupv3_se0_i2c и qupv3_se12_i2c.
 * В mainline драйвер KTZ8866 есть, но compatible `kinetic,ktz8866`
 * (downstream `ktz,ktz8866`) — согласовать. GPIO hwen/enp/enn/panelid уточнить.
 */
&i2c0 {
	status = "okay";

	backlight@11 {
		compatible = "kinetic,ktz8866";
		reg = <0x11>;
	};
};

&i2c12 {
	status = "okay";

	backlight@11 {
		compatible = "kinetic,ktz8866";
		reg = <0x11>;
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;

	status = "okay";
};

&pm7550_flash {
	status = "okay";

	led-0 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_YELLOW>;
		led-sources = <1>, <4>;
		led-max-microamp = <500000>;
		flash-max-microamp = <2000000>;
		flash-max-timeout-us = <1280000>;
		function-enumerator = <0>;
	};

	led-1 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		led-sources = <2>, <3>;
		led-max-microamp = <500000>;
		flash-max-microamp = <2000000>;
		flash-max-timeout-us = <1280000>;
		function-enumerator = <1>;
	};
};

&pm7550_gpios {
	volume_up_n: volume-up-n-state {
		pins = "gpio6";
		function = "normal";
		power-source = <1>;
		bias-pull-up;
		input-enable;
	};
};

&pm7550_pwm {
	status = "okay";

	multi-led {
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_STATUS;

		#address-cells = <1>;
		#size-cells = <0>;

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_RED>;
		};

		led@2 {
			reg = <2>;
			color = <LED_COLOR_ID_GREEN>;
		};

		led@3 {
			reg = <3>;
			color = <LED_COLOR_ID_BLUE>;
		};
	};
};

&pm7550ba_eusb2_repeater {
	vdd3-supply = <&vreg_l17b_3p3>;
	vdd18-supply = <&vreg_l7b_1p8>;

	/*
	 * TODO: downstream uke задаёт qcom,param-override-seq
	 * (обычный / factory / host). Перенести при проверке USB.
	 */
};

&pm8550vs_c {
	status = "okay";
};

&pm8550vs_d {
	status = "okay";
};

&pm8550vs_e {
	status = "okay";
};

&pm8550vs_g {
	status = "okay";
};

&qupv3_id_0 {
	status = "okay";
};

&qupv3_id_1 {
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/lamma/adsp2.mbn",
			"qcom/lamma/adsp2_dtb.mbn";
	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/palawan/cdsp.mbn",
			"qcom/palawan/cdsp_dtb.mbn";
	status = "okay";
};

&remoteproc_mpss {
	/* uke: модема нет (downstream отключает mpss_mem/modem_pas) */
	status = "disabled";
};

&remoteproc_wpss {
	firmware-name = "qcom/palawan/wpss.mbn";

	status = "okay";
};

&sleep_clk {
	clock-frequency = <32764>;
};

/*
 * Тачскрин uke — Novatek NT36532E (варианты CSOT / TM), SPI, TDDI.
 * Downstream (qupv3_se4_spi): IRQ gpio54, lcd_id gpio26, reset не задан.
 * Драйвер: kernel/drivers/nt36532-uke.c (черновик mainline-порта).
 * TODO: уточнить reset, питание (vdd/vddio) и вариант CSOT/TM.
 */
&spi4 {
	status = "okay";

	touchscreen@0 {
		compatible = "novatek,NVT-ts";
		reg = <0>;

		interrupt-parent = <&tlmm>;
		interrupts = <54 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_l22b_3p4>;
		vddio-supply = <&vreg_l8b_1p8>;

		firmware-name = "novatek_nt36532_o82_fw_csot.bin";

		spi-max-frequency = <10000000>;

		pinctrl-0 = <&ts_irq>;
		pinctrl-names = "default";

		/* TODO: lcd_id gpio26, reset, CSOT/TM профиль */
	};
};

&tlmm {
	gpio-reserved-ranges = <56 5>;

	bt_default: bt-default-state {
		bt-en-pins {
			pins = "gpio156";
			function = "gpio";
			drive-strength = <16>;
			bias-disable;
		};

		sw-ctrl-pins {
			pins = "gpio80";
			function = "gpio";
			bias-pull-down;
		};
	};

	disp0_reset_n_active: disp0-reset-n-active-state {
		pins = "gpio2"; /* uke: O82 panel reset */
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
		pins = "gpio2"; /* uke: O82 panel reset */
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdp_vsync: mdp-vsync-state {
		pins = "gpio77";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	spkr_2_sd_n_active: spkr-2-sd-n-active-state {
		pins = "gpio76";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};

	ts_irq: ts-irq-state {
		pins = "gpio54"; /* uke: Novatek NT36532 IRQ */
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-disable;
	};

	wcd_default: wcd-reset-n-active-state {
		pins = "gpio12";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};
};

