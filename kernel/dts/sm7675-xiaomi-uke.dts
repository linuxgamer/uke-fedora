		vddrfa1p3-supply = <&vreg_s2b_1p4>;
		vddrfa1p8-supply = <&vreg_s1b_2p04>;
		vddrfa2p2-supply = <&vreg_s3e_2p4>;

		max-speed = <3200000>;
