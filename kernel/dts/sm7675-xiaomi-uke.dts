/*
 * TODO: uke маршрутизирует USB2 D+/D- через WCD939x
 * (downstream: &usb0 { qcom,wcd_usbss = <&wcd_usbss>; }).
 * Для bring-up — peripheral (gadget), затем добавить WCD939x-роут.
 */
&usb_1 {
	dr_mode = "peripheral";

	status = "okay";
};

/* Обратная ссылка графа pmic-glink<->dwc3 (pmic-glink при bring-up disabled). */
&usb_1_dwc3_hs {
