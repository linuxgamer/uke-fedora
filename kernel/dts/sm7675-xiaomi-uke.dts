// SPDX-License-Identifier: BSD-3-Clause
/*
 * Copyright (c) 2026, Alexandr Zubtsov <devizure@mainlining.org>
 *
 * ЧЕРНОВИК board DTS для Xiaomi Pad 7 (uke, SM7675 / lamma).
 * База: lamma-qrd.dts (palawan-mainline palawan/v7.2-rc2).
 * uke-специфика сверена с downstream MiCode uke-v-oss (uke-sm8635.dtsi).
 * Требует проверки на реальном устройстве. Место в дереве:
 *   arch/arm64/boot/dts/qcom/sm7675-xiaomi-uke.dts
 *
 * Открытые TODO по uke (см. также docs/BRINGUP-NOTES.md):
 *   - панель O82: DUAL DSI + DSC; в palawan.dtsi только mdss_dsi0, нужен dsi1
 *     и драйвер панели (reset gpio2, vsp/vsn gpio74/75, vddil8b=L8B 1.9V)
 *   - тачскрин Novatek NT36532E (CSOT/TM), драйвер в mainline не подтверждён
 *   - подсветка 2x KTZ8866 @0x11 на i2c0/i2c12 (mainline compatible ok)
 *   - WCD939x USB2-роут (downstream: qcom,wcd_usbss) + param-override eUSB2
 *   - таблица регуляторов: скопирована из lamma-qrd, требует сверки с uke
 * Память и reserved-memory уже в palawan.dtsi (размер заполняет загрузчик).
 */

/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "lamma.dtsi"
#include "pm7550.dtsi" /* PMXR2230 */
#include "pm7550ba.dtsi"
#include "pmr735a.dtsi"
#include "pm8010.dtsi"
#define PMK8550VE_SID 3
#include "pm8550ve.dtsi"
#include "pm8550vs.dtsi"
#include "pmk8550.dtsi"

/ {
	model = "Xiaomi Pad 7";
	compatible = "xiaomi,uke", "qcom,lamma";

	aliases {
		serial0 = &uart5;
		serial1 = &uart10;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:115200n8";

		/*
		 * Ранний bring-up: ABL-фреймбуфер uke (подтверждён ztsubaki).
		 * Включить для simplefb-консоли; требует сохранить splash_region
		 * (43 МиБ) как no-map, иначе кэш-алиасинг с обычной RAM.
		 */
		framebuffer@e3940000 {
			compatible = "simple-framebuffer";
			reg = <0 0xe3940000 0 0x01a13000>;
			width = <3200>;
			height = <2136>;
			stride = <12800>;
			format = "a8r8g8b8";
			status = "disabled"; /* TODO: включить для simplefb-консоли */
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&volume_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm7550_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "qcom,lamma-pmic-glink",
			     "qcom,sm8550-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
		/* bring-up: USB только peripheral, role-switch не используем */
		status = "disabled";
		orientation-gpios = <&tlmm 122 GPIO_ACTIVE_HIGH>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;

			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_1_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <0>;
					};
				};

				port@2 {
					reg = <2>;

					pmic_glink_sbu: endpoint {
						remote-endpoint = <0>;
					};
				};
			};
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";

		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;

		regulator-always-on;
		regulator-boot-on;
	};
};

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm7550-rpmh-regulators";
		qcom,pmic-id = "b";

		vreg_bob: bob {
			regulator-name = "vreg_bob";
			regulator-min-microvolt = <3008000>;
			regulator-max-microvolt = <3960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s1b_2p04: smps1 {
			regulator-name = "vreg_s1b_2p04";
			regulator-min-microvolt = <1856000>;
			regulator-max-microvolt = <2040000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

