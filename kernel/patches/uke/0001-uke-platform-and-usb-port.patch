+#define DEBUG_PRINT_BUFFER_SIZE 256
+static const char *const rpmh_regulator_state_names[] = {
+	[RPMH_SLEEP_STATE]		= "sleep ",
+	[RPMH_WAKE_ONLY_STATE]		= "wake  ",
+	[RPMH_ACTIVE_ONLY_STATE]	= "active",
+};
