diff --git a/drivers/usb/common/wcd939x-usb-uke.c b/drivers/usb/common/wcd939x-usb-uke.c
new file mode 100644
index 000000000..cbfa0c1d2
--- /dev/null
+++ b/drivers/usb/common/wcd939x-usb-uke.c
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal WCD939x USB2 routing for Xiaomi Uke.
+ *
+ * Derived from the public Xiaomi WCD USBSS driver and the upstream
+ * wcd939x-usbss driver.  Uke uses this chip between its eUSB2 PHY and the
+ * receptacle.  This driver deliberately configures only the fixed USB2
+ * peripheral route; Type-C alternate modes, audio accessory handling, UCSI,
+ * and charger detection are outside its scope.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+
+#define WCD_USBSS_DP_DN_MISC1			0x20
+#define WCD_USBSS_DP_DN_DYN_BST		(BIT(3) | BIT(0))
+#define WCD_USBSS_CPLDO_CTL2			0xa1
+#define WCD_USBSS_SWITCH_SETTINGS_ENABLE	0x403
+#define WCD_USBSS_DEVICE_ENABLE		BIT(7)
+#define WCD_USBSS_DNL_ENABLE			BIT(4)
+#define WCD_USBSS_DPR_ENABLE			BIT(3)
+#define WCD_USBSS_SWITCH_SELECT0		0x404
+#define WCD_USBSS_DNL_SELECT			GENMASK(5, 4)
+#define WCD_USBSS_DPR_SELECT			GENMASK(3, 2)
+#define WCD_USBSS_DNL_DN			FIELD_PREP(WCD_USBSS_DNL_SELECT, 1)
+#define WCD_USBSS_DPR_DP			FIELD_PREP(WCD_USBSS_DPR_SELECT, 1)
+#define WCD_USBSS_FUNCTION_ENABLE		0x413
+#define WCD_USBSS_MANUAL_MODE			FIELD_PREP(GENMASK(1, 0), 1)
+#define WCD_USBSS_EQUALIZER1			0x415
+#define WCD_USBSS_EQUALIZER_ENABLE		BIT(7)
+#define WCD_USBSS_EQUALIZER_BW			GENMASK(6, 3)
+#define WCD_USBSS_USB_SS_CNTL			0x419
+#define WCD_USBSS_STANDBY			BIT(4)
+#define WCD_USBSS_RCO_ENABLE			BIT(3)
+#define WCD_USBSS_USB_MODE			GENMASK(2, 0)
+#define WCD_USBSS_USB_MODE_5			FIELD_PREP(WCD_USBSS_USB_MODE, 5)
+#define WCD_USBSS_FSM_OVERRIDE			0x63
+#define WCD_USBSS_DP_EN			0x1e
+#define WCD_USBSS_DN_EN			0x21
+#define WCD_USBSS_MAX_REGISTER			0x4c1
+
+struct wcd939x_usb_uke {
+	struct regulator *supply;
+	struct gpio_desc *reset;
+	struct regmap *regmap;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *active;
+};
+
+static const struct regmap_range_cfg wcd939x_usb_uke_ranges[] = {
+	{
+		.range_min = 0,
+		.range_max = WCD_USBSS_MAX_REGISTER,
+		.selector_reg = 0,
+		.selector_mask = 0xff,
+		.window_start = 0,
+		.window_len = 0x100,
+	},
+};
+
+static const struct regmap_config wcd939x_usb_uke_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = WCD_USBSS_MAX_REGISTER,
+	.ranges = wcd939x_usb_uke_ranges,
+	.num_ranges = ARRAY_SIZE(wcd939x_usb_uke_ranges),
+};
+
+static int wcd939x_usb_uke_route(struct wcd939x_usb_uke *wcd, u32 eq_bw)
+{
+	int ret;
+
+	ret = regmap_clear_bits(wcd->regmap, WCD_USBSS_USB_SS_CNTL,
+				WCD_USBSS_STANDBY);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(wcd->regmap, WCD_USBSS_FUNCTION_ENABLE,
+				 GENMASK(1, 0), WCD_USBSS_MANUAL_MODE);
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(wcd->regmap, WCD_USBSS_DP_DN_MISC1,
+				WCD_USBSS_DP_DN_DYN_BST);
+	if (ret)
+		return ret;
+
+	/* Uke vendor OVP-fuse settings for the USB route. */
+	ret = regmap_update_bits(wcd->regmap, WCD_USBSS_FSM_OVERRIDE, 0x77, 0x77);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(wcd->regmap, WCD_USBSS_DP_EN, 0x0e, 0x0c);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(wcd->regmap, WCD_USBSS_DN_EN, 0x0e, 0x0c);
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(wcd->regmap, WCD_USBSS_CPLDO_CTL2, 0xff);
+	if (ret)
+		return ret;
+
+	ret = regmap_clear_bits(wcd->regmap, WCD_USBSS_USB_SS_CNTL,
+				WCD_USBSS_RCO_ENABLE);
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(wcd->regmap, WCD_USBSS_USB_SS_CNTL,
+				WCD_USBSS_RCO_ENABLE);
+	if (ret)
+		return ret;
+	ret = regmap_write(wcd->regmap, WCD_USBSS_SWITCH_SETTINGS_ENABLE,
+			   WCD_USBSS_DEVICE_ENABLE);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(wcd->regmap, WCD_USBSS_USB_SS_CNTL,
+				WCD_USBSS_USB_MODE, WCD_USBSS_USB_MODE_5);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(wcd->regmap, WCD_USBSS_SWITCH_SELECT0,
+				WCD_USBSS_DNL_SELECT | WCD_USBSS_DPR_SELECT,
+				WCD_USBSS_DNL_DN | WCD_USBSS_DPR_DP);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(wcd->regmap, WCD_USBSS_EQUALIZER1,
+				WCD_USBSS_EQUALIZER_ENABLE | WCD_USBSS_EQUALIZER_BW,
+				WCD_USBSS_EQUALIZER_ENABLE |
+				FIELD_PREP(WCD_USBSS_EQUALIZER_BW, eq_bw));
+	if (ret)
+		return ret;
+
+	return regmap_set_bits(wcd->regmap, WCD_USBSS_SWITCH_SETTINGS_ENABLE,
+				WCD_USBSS_DNL_ENABLE | WCD_USBSS_DPR_ENABLE);
+}
+
+static int wcd939x_usb_uke_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct wcd939x_usb_uke *wcd;
+	u32 eq_bw = 8;
+	int ret;
+
+	wcd = devm_kzalloc(dev, sizeof(*wcd), GFP_KERNEL);
+	if (!wcd)
+		return -ENOMEM;
+
+	wcd->regmap = devm_regmap_init_i2c(client, &wcd939x_usb_uke_regmap_config);
+	if (IS_ERR(wcd->regmap))
+		return dev_err_probe(dev, PTR_ERR(wcd->regmap), "failed to initialize regmap\n");
+	wcd->supply = devm_regulator_get(dev, "vdd-usb-cp");
+	if (IS_ERR(wcd->supply))
+		return dev_err_probe(dev, PTR_ERR(wcd->supply), "failed to get vdd-usb-cp\n");
+
+	wcd->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(wcd->pinctrl))
+		return dev_err_probe(dev, PTR_ERR(wcd->pinctrl), "failed to get pinctrl\n");
+	wcd->active = pinctrl_lookup_state(wcd->pinctrl, "usbss_active");
+	if (IS_ERR(wcd->active))
+		wcd->active = pinctrl_lookup_state(wcd->pinctrl, "active");
+	if (IS_ERR(wcd->active))
+		return dev_err_probe(dev, PTR_ERR(wcd->active), "failed to get active pins\n");
+	ret = pinctrl_select_state(wcd->pinctrl, wcd->active);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to select active pins\n");
+
+	/* Select pins first, then assert reset using the DT active-low polarity. */
+	wcd->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(wcd->reset))
+		return dev_err_probe(dev, PTR_ERR(wcd->reset), "failed to get reset GPIO\n");
+
+	ret = regulator_enable(wcd->supply);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable vdd-usb-cp\n");
+	msleep(20);
+	gpiod_set_value_cansleep(wcd->reset, 0);
+	msleep(20);
+
+	of_property_read_u32(dev->of_node, "wcd-equ-bw-settings", &eq_bw);
+	if (eq_bw > 0xf) {
+		ret = -EINVAL;
+		dev_err(dev, "invalid equalizer bandwidth %u\n", eq_bw);
+		goto disable_supply;
+	}
+	ret = wcd939x_usb_uke_route(wcd, eq_bw);
+	if (ret) {
+		dev_err(dev, "failed to route USB2 D+/D-: %d\n", ret);
+		goto disable_supply;
+	}
+
+	i2c_set_clientdata(client, wcd);
+	return 0;
+
+disable_supply:
+	gpiod_set_value_cansleep(wcd->reset, 1);
+	regulator_disable(wcd->supply);
+	return ret;
+}
+
+static void wcd939x_usb_uke_remove(struct i2c_client *client)
+{
+	struct wcd939x_usb_uke *wcd = i2c_get_clientdata(client);
+
+	regmap_clear_bits(wcd->regmap, WCD_USBSS_SWITCH_SETTINGS_ENABLE,
+			  WCD_USBSS_DNL_ENABLE | WCD_USBSS_DPR_ENABLE);
+	gpiod_set_value_cansleep(wcd->reset, 1);
+	regulator_disable(wcd->supply);
+}
+
+static const struct of_device_id wcd939x_usb_uke_of_match[] = {
+	{ .compatible = "qcom,sm7675-wcd939x-usb2" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, wcd939x_usb_uke_of_match);
+
+static struct i2c_driver wcd939x_usb_uke_driver = {
+	.driver = {
+		.name = "wcd939x-usb-uke",
+		.of_match_table = wcd939x_usb_uke_of_match,
+	},
+	.probe = wcd939x_usb_uke_probe,
+	.remove = wcd939x_usb_uke_remove,
+};
+module_i2c_driver(wcd939x_usb_uke_driver);
+
+MODULE_DESCRIPTION("Xiaomi Uke WCD939x fixed USB2 routing driver");
+MODULE_LICENSE("GPL");
