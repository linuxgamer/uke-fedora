+static const struct qcom_cc_desc tcsr_cc_pineapple_desc = {
+	.config = &tcsr_cc_pineapple_regmap_config,
+	.clks = tcsr_cc_pineapple_clocks,
+	.num_clks = ARRAY_SIZE(tcsr_cc_pineapple_clocks),
