diff --git a/drivers/clk/clk_test.c b/drivers/clk/clk_test.c
index aa3ddcfc0..120ddb5d5 100644
--- a/drivers/clk/clk_test.c
+++ b/drivers/clk/clk_test.c
@@ -11,6 +11,7 @@
 #include "clk.h"
 
 #include <kunit/clk.h>
+#include <kunit/device.h>
 #include <kunit/of.h>
 #include <kunit/platform_device.h>
 #include <kunit/test.h>
@@ -3075,7 +3076,141 @@ static struct kunit_suite clk_register_clk_parent_data_device_suite = {
 	.test_cases = clk_register_clk_parent_data_device_test_cases,
 };
 
+/* Boot handoff regressions: consumer refs, orphan reparent and failed hold. */
+struct clk_hold_test_context {
+	struct clk_hw hw;
+	bool enabled;
+	int prepare_error;
+};
+
+static int clk_hold_test_prepare(struct clk_hw *hw)
+{
+	return container_of(hw, struct clk_hold_test_context, hw)->prepare_error;
+}
+
+static int clk_hold_test_enable(struct clk_hw *hw)
+{
+	container_of(hw, struct clk_hold_test_context, hw)->enabled = true;
+	return 0;
+}
+
+static void clk_hold_test_disable(struct clk_hw *hw)
+{
+	container_of(hw, struct clk_hold_test_context, hw)->enabled = false;
+}
+
+static int clk_hold_test_is_enabled(struct clk_hw *hw)
+{
+	return container_of(hw, struct clk_hold_test_context, hw)->enabled;
+}
+
+static const struct clk_ops clk_hold_test_ops = {
+	.prepare = clk_hold_test_prepare,
+	.enable = clk_hold_test_enable,
+	.disable = clk_hold_test_disable,
+	.is_enabled = clk_hold_test_is_enabled,
+};
+
+static void clk_hold_consumer_test(struct kunit *test)
+{
+	struct clk_hold_test_context *ctx;
+	struct clk_init_data init = {
+		.name = "uke-hold-consumer",
+		.ops = &clk_hold_test_ops,
+		.flags = CLK_HOLD_STATE,
+	};
+	struct device *dev;
+	struct clk *clk;
+
+	dev = kunit_device_register(test, "uke-hold-consumer");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->enabled = true;
+	ctx->hw.init = &init;
+	KUNIT_ASSERT_EQ(test, clk_hw_register_kunit(test, dev, &ctx->hw), 0);
+	clk = clk_hw_get_clk_prepared_enabled_kunit(test, &ctx->hw, NULL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, clk);
+	KUNIT_EXPECT_EQ(test, __clk_get_enable_count(clk), 2U);
+	KUNIT_ASSERT_EQ(test, clk_sync_state(dev), 0);
+	KUNIT_EXPECT_EQ(test, __clk_get_enable_count(clk), 1U);
+	KUNIT_EXPECT_TRUE(test, ctx->enabled);
+	KUNIT_ASSERT_EQ(test, clk_sync_state(dev), 0);
+	KUNIT_EXPECT_EQ(test, __clk_get_enable_count(clk), 1U);
+}
+
+static void clk_hold_orphan_test(struct kunit *test)
+{
+	const char *parent_name = "uke-hold-parent";
+	struct clk_hold_test_context *child, *parent;
+	struct clk_init_data init = {
+		.name = "uke-hold-orphan",
+		.ops = &clk_hold_test_ops,
+		.flags = CLK_HOLD_STATE,
+		.parent_names = &parent_name,
+		.num_parents = 1,
+	};
+	struct device *dev;
+
+	dev = kunit_device_register(test, "uke-hold-orphan");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	child = kunit_kzalloc(test, sizeof(*child), GFP_KERNEL);
+	parent = kunit_kzalloc(test, sizeof(*parent), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, child);
+	KUNIT_ASSERT_NOT_NULL(test, parent);
+	child->enabled = true;
+	child->hw.init = &init;
+	KUNIT_ASSERT_EQ(test, clk_hw_register_kunit(test, dev, &child->hw), 0);
+	KUNIT_EXPECT_EQ(test, clk_sync_state(dev), -EAGAIN);
+	KUNIT_EXPECT_TRUE(test, child->enabled);
+	init.name = parent_name;
+	init.parent_names = NULL;
+	init.num_parents = 0;
+	parent->enabled = true;
+	parent->hw.init = &init;
+	KUNIT_ASSERT_EQ(test, clk_hw_register_kunit(test, dev, &parent->hw), 0);
+	KUNIT_EXPECT_PTR_EQ(test, clk_hw_get_parent(&child->hw), &parent->hw);
+	KUNIT_ASSERT_EQ(test, clk_sync_state(dev), 0);
+	KUNIT_EXPECT_FALSE(test, child->enabled);
+	KUNIT_EXPECT_FALSE(test, parent->enabled);
+}
+
+static void clk_hold_failure_test(struct kunit *test)
+{
+	struct clk_hold_test_context *ctx;
+	struct clk_init_data init = {
+		.name = "uke-hold-failure",
+		.ops = &clk_hold_test_ops,
+		.flags = CLK_HOLD_STATE,
+	};
+	struct device *dev;
+
+	dev = kunit_device_register(test, "uke-hold-failure");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->enabled = true;
+	ctx->prepare_error = -EIO;
+	ctx->hw.init = &init;
+	KUNIT_ASSERT_EQ(test, clk_hw_register_kunit(test, dev, &ctx->hw), 0);
+	KUNIT_EXPECT_EQ(test, clk_sync_state(dev), -EAGAIN);
+	KUNIT_EXPECT_TRUE(test, ctx->enabled);
+}
+
+static struct kunit_case clk_hold_test_cases[] = {
+	KUNIT_CASE(clk_hold_consumer_test),
+	KUNIT_CASE(clk_hold_orphan_test),
+	KUNIT_CASE(clk_hold_failure_test),
+	{}
+};
+
+static struct kunit_suite clk_hold_test_suite = {
+	.name = "clk_uke_handoff",
+	.test_cases = clk_hold_test_cases,
+};
+
 kunit_test_suites(
+	&clk_hold_test_suite,
 	&clk_leaf_mux_set_rate_parent_test_suite,
 	&clk_test_suite,
 	&clk_multiple_parents_mux_test_suite,
