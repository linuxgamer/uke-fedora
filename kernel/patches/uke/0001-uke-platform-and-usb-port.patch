--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -76,6 +76,8 @@ struct clk_core {
 	struct clk_core		*new_child;
 	unsigned long		flags;
 	bool			orphan;
+	bool			boot_enabled;
+	bool			need_sync;
 	bool			rpm_enabled;
