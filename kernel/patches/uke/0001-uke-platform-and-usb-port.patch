+#define GCC_PCIE_0_SLV_Q2A_AXI_CLK				45
+#define GCC_PCIE_RSCC_CFG_AHB_CLK				46
+#define GCC_PCIE_RSCC_XO_CLK					47
+#define GCC_PDM2_CLK						48
