+	[RPMH_REGULATOR_REG_VRM_ENABLE]		= "en",
+	[RPMH_REGULATOR_REG_VRM_MODE]		= "mode",
+	[RPMH_REGULATOR_REG_VRM_HEADROOM]	= "hr_mv",
+};
+
