diff --git a/drivers/interconnect/qcom/icc-rpmh.c b/drivers/interconnect/qcom/icc-rpmh.c
index f49a8e0cb..bc2c3f6c0 100644
--- a/drivers/interconnect/qcom/icc-rpmh.c
+++ b/drivers/interconnect/qcom/icc-rpmh.c
@@ -301,22 +301,34 @@ int qcom_icc_rpmh_probe(struct platform_device *pdev)
 		void __iomem *base;
 
 		base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
-		if (IS_ERR(base))
+		if (IS_ERR(base)) {
+			ret = PTR_ERR(base);
+			if (desc->qos_required)
+				goto err_remove_nodes;
 			goto skip_qos_config;
+		}
 
 		qp->regmap = devm_regmap_init_mmio(dev, base, desc->config);
 		if (IS_ERR(qp->regmap)) {
+			ret = PTR_ERR(qp->regmap);
+			if (desc->qos_required)
+				goto err_remove_nodes;
 			dev_info(dev, "Skipping QoS, regmap failed; %ld\n", PTR_ERR(qp->regmap));
 			goto skip_qos_config;
 		}
 
 		qp->num_clks = devm_clk_bulk_get_all(qp->dev, &qp->clks);
 		if (qp->num_clks < 0 || (!qp->num_clks && desc->qos_clks_required)) {
+			ret = qp->num_clks < 0 ? qp->num_clks : -EINVAL;
+			if (desc->qos_required)
+				goto err_remove_nodes;
 			dev_info(dev, "Skipping QoS, failed to get clk: %d\n", qp->num_clks);
 			goto skip_qos_config;
 		}
 
 		ret = qcom_icc_rpmh_configure_qos(qp);
+		if (ret && desc->qos_required)
+			goto err_remove_nodes;
 		if (ret)
 			dev_info(dev, "Failed to program QoS: %d\n", ret);
 	}
